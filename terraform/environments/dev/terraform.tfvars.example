project_name = "inventory-cloud"
environment  = "dev"
aws_region   = "us-east-1"
vpc_cidr     = "10.0.0.0/16"

# Base de Datos PostgreSQL
database_name     = "inventory_db"
database_username = "postgresadmin"
database_password = "TuPasswordSeguroRDS2026!"

# Seguridad JWT
secret_key = "tu_clave_secreta_jwt_de_256_bits_aqui"

