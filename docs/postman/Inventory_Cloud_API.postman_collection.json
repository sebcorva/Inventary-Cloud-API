{
	"info": {
		"_postman_id": "c1f7a022-7f28-4e89-9a21-12c8b8f2a9d1",
		"name": "Inventory Cloud API (FastAPI + AWS)",
		"description": "Colección completa para pruebas de la API de Inventario en la nube con FastAPI, PostgreSQL, AWS S3 y Amazon SQS.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "System",
			"item": [
				{
					"name": "Health Check (ALB Monitor)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/health",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"health"
							]
						},
						"description": "Verifica el estado del servicio y monitoreo para el Application Load Balancer."
					},
					"response": []
				}
			]
		},
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testuser\",\n    \"email\": \"testuser@example.com\",\n    \"password\": \"Secret123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"register"
							]
						},
						"description": "Registra un nuevo usuario en la base de datos PostgreSQL."
					},
					"response": []
				},
				{
					"name": "Login (OAuth2 Form)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var data = pm.response.json();",
									"    if (data.access_token) {",
									"        pm.collectionVariables.set('access_token', data.access_token);",
									"        console.log('Token JWT guardado automáticamente en {{access_token}}');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "username",
									"value": "testuser",
									"type": "text"
								},
								{
									"key": "password",
									"value": "Secret123!",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Inicia sesión y almacena automáticamente el token JWT en la variable de colección {{access_token}}."
					},
					"response": []
				}
			]
		},
		{
			"name": "Products",
			"item": [
				{
					"name": "List Products (Public)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/products?skip=0&limit=10",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"products"
							],
							"query": [
								{
									"key": "skip",
									"value": "0"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						},
						"description": "Lista productos del catálogo con soporte de paginación."
					},
					"response": []
				},
				{
					"name": "Create Product (Emits SQS PRODUCT_CREATED)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var data = pm.response.json();",
									"    if (data.id) {",
									"        pm.collectionVariables.set('product_id', data.id);",
									"        console.log('ID del producto guardado en {{product_id}}:', data.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"MacBook Pro M3 Max\",\n    \"description\": \"Laptop de alto rendimiento para desarrollo en la nube\",\n    \"price\": 3499.99,\n    \"stock\": 15\n}"
						},
						"url": {
							"raw": "{{base_url}}/products",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"products"
							]
						},
						"description": "Crea un producto asociado al usuario autenticado y despacha en segundo plano un evento PRODUCT_CREATED a Amazon SQS."
					},
					"response": []
				},
				{
					"name": "Get Product by ID (Public)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/products/{{product_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"products",
								"{{product_id}}"
							]
						},
						"description": "Obtiene la información y URL de imagen en S3 de un producto específico."
					},
					"response": []
				},
				{
					"name": "Upload Product Image to AWS S3",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": []
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/products/{{product_id}}/image",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"products",
								"{{product_id}}",
								"image"
							]
						},
						"description": "Sube una imagen (JPEG/PNG/WEBP) a AWS S3 con UUID único, actualiza la URL en la base de datos y despacha el evento PRODUCT_IMAGE_UPLOADED a SQS."
					},
					"response": []
				},
				{
					"name": "Update Product (Trigger LOW_STOCK_ALERT)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"MacBook Pro M3 Max (Últimas Unidades)\",\n    \"price\": 3299.99,\n    \"stock\": 2\n}"
						},
						"url": {
							"raw": "{{base_url}}/products/{{product_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"products",
								"{{product_id}}"
							]
						},
						"description": "Actualiza el producto. Al establecer stock <= 5, el sistema detecta inventario crítico y despacha automáticamente una alerta LOW_STOCK_ALERT a SQS."
					},
					"response": []
				},
				{
					"name": "Delete Product (Cleans S3 & DB)",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/products/{{product_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"products",
								"{{product_id}}"
							]
						},
						"description": "Elimina el producto de PostgreSQL y remueve físicamente el archivo multimedia del bucket S3."
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "access_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "product_id",
			"value": "1",
			"type": "string"
		}
	]
}
